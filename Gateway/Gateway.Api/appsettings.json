{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317",
    "Protocol": "Grpc",
    "Application": "Gateway.Api"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "notification/{**catchall}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catchall}"
          }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "order/{**catchall}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catchall}"
          }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "user/{**catchall}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catchall}"
          }
        ]
      }
    },
    "Clusters": {
      "notification-cluster": {
        "ClusterId": "notification-cluster",
        "Destinations": {
          "BackendUrl": {
            "DestinationId": "notification",
            "Address": "https://localhost:7175"
          }
        }
      },
      "order-cluster": {
        "ClusterId": "order-cluster",
        "Destinations": {
          "BackendUrl": {
            "DestinationId": "order",
            "Address": "https://localhost:7176"
          }
        }
      },
      "user-cluster": {
        "ClusterId": "user-cluster",
        "Destinations": {
          "BackendUrl": {
            "DestinationId": "user",
            "Address": "https://localhost:7085"
          }
        }
      }
    }
  }
}
